{
  "rewrites": [
    {
      "source": "/api/leaderboards/:path*",
      "destination": "https://aimlab-staging-api.saibot.site/api/leaderboards/:path*"
    },
    {
      "source": "/api/profiles/:path*",
      "destination": "https://aimlab-staging-api.saibot.site/api/profiles/:path*"
    },
    {
      "source": "/api/tasks/:path*",
      "destination": "https://aimlab-staging-api.saibot.site/api/tasks/:path*"
    },
    {
      "source": "/api/benchmarks/:path*",
      "destination": "https://aimlab-staging-api.saibot.site/api/benchmarks/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
