[Unit]
Description=Aimlab Benchmarks Viewer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/sai/apps/aimlab-viewer
Environment=PORT=5180
Environment=AIMLAB_DATA_DIR=/home/sai/.local/share/aimlab-viewer
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
