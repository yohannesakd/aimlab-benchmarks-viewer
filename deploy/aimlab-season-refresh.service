[Unit]
Description=Refresh Voltaic Aimlabs Season 3 and Season 2 standings
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/sai/code/aimlab/worktrees/staging
Environment=AIMLAB_DATA_DIR=/home/sai/code/aimlab/data/leaderboards
EnvironmentFile=-/home/sai/code/aimlab/config/viewer/posthog.env
Environment=AIMLAB_ENV=staging
Environment=POSTHOG_SERVICE=aimlab-collector
ExecStart=/usr/bin/flock -n /home/sai/code/aimlab/data/leaderboards/refresh.lock /home/sai/.nvm/versions/node/v24.16.0/bin/node server/refresh-database.js vt-aimlabs_s3-advanced vt-aimlabs_s3-intermediate vt-aimlabs_s3-novice vt-aimlabs_s2-advanced vt-aimlabs_s2-intermediate vt-aimlabs_s2-novice
TimeoutStartSec=12h
Nice=10
