[Unit]
Description=Refresh Revosect and Voltaic benchmark leaderboards
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/sai/code/aimlab/runtime/current
Environment=AIMLAB_DATA_DIR=/home/sai/code/aimlab/data/leaderboards
EnvironmentFile=-/home/sai/code/aimlab/config/viewer/posthog.env
Environment=AIMLAB_ENV=production
Environment=POSTHOG_SERVICE=aimlab-collector
ExecStart=/usr/bin/flock -n /home/sai/code/aimlab/data/leaderboards/refresh.lock /home/sai/.nvm/versions/node/v24.16.0/bin/node server/refresh-database.js
TimeoutStartSec=24h
Nice=10
