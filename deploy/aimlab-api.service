[Unit]
Description=Read-only Aimlab leaderboard API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/sai/code/aimlab/runtime/current
Environment=AIMLAB_DATA_DIR=/home/sai/code/aimlab/data/leaderboards
EnvironmentFile=-/home/sai/code/aimlab/config/viewer/posthog.env
Environment=AIMLAB_ENV=production
Environment=POSTHOG_SERVICE=aimlab-api
ExecStart=/home/sai/.nvm/versions/node/v24.16.0/bin/node server/public-api.js
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
