[Unit]
Description=Read-only Aimlab staging API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/sai/code/aimlab/worktrees/staging
Environment=AIMLAB_DATA_DIR=/home/sai/code/aimlab/data/leaderboards
EnvironmentFile=-/home/sai/code/aimlab/config/viewer/posthog.env
Environment=AIMLAB_ENV=staging
Environment=POSTHOG_SERVICE=aimlab-api
Environment=PUBLIC_API_PORT=5282
ExecStart=/home/sai/.nvm/versions/node/v24.16.0/bin/node server/public-api.js
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
