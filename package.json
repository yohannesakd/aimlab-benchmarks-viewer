{
  "name": "aimlab-benchmarks-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --ssrManifest && vite build --ssr src/entry-server.js --outDir dist-ssr && node scripts/upload-source-maps.js && node scripts/build-seo.js",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "start": "node server/index.js",
    "refresh:database": "node server/refresh-database.js",
    "start:public-api": "node server/public-api.js",
    "import:benchmarks": "python3 scripts/import-benchmark-seasons.py",
    "test:browser": "playwright test",
    "test:import": "python3 -m unittest discover -s tests -p \"test_*.py\""
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "energy-calculation": "1.0.1",
    "posthog-js": "^1.435.5",
    "posthog-node": "5.55.0",
    "sharp": "^0.35.5",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@posthog/cli": "0.18.9",
    "@vitejs/plugin-vue": "^6.0.9",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.10",
    "prettier": "^2.7.1",
    "prettier-plugin-tailwindcss": "^0.1.13",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
