    "prettier": "^2.7.1",
    "prettier-plugin-tailwindcss": "^0.1.13",
    "vite": "^8.3.1",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "@playwright/test": "^1.63.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
